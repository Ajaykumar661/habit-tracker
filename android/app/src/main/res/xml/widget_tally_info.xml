<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is the floor Android allows (30 min); it is only
     there so the widget notices the day turning over. The app pushes every
     real change itself. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_tally"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="90dp"
    android:previewLayout="@layout/widget_tally"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
