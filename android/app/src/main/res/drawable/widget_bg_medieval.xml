<?xml version="1.0" encoding="utf-8"?>
<!-- Dark wood with a brass edge, like the plaques in the keep. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F21A1109" />
            <stroke android:width="2dp" android:color="#8A6A3A" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#402E1A" />
        </shape>
    </item>
</layer-list>
