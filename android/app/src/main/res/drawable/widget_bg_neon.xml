<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass with a lit cyan edge and a pink inner line. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F207060F" />
            <stroke android:width="2dp" android:color="#3CE8FF" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#66FF4FC8" />
        </shape>
    </item>
</layer-list>
